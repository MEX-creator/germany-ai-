generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Conversation {
  id        Int       @id @default(autoincrement())
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  topic     String?
  messages  Message[]
}

model Message {
  id             Int          @id @default(autoincrement())
  content        String
  translation    String?
  role           String
  createdAt      DateTime     @default(now())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model VocabularyItem {
  id         Int         @id @default(autoincrement())
  german     String
  english    String
  example    String?
  sourceConversationId Int?
  // SM-2 algorithm fields
  easeFactor  Float   @default(2.5)
  interval    Int     @default(0)
  repetitions Int     @default(0)
  nextReviewAt DateTime @default(now())
  lastReviewedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reviewLogs  ReviewLog[]

  @@index([nextReviewAt])
  @@index([german])
}

model ReviewLog {
  id              Int             @id @default(autoincrement())
  vocabularyItemId Int
  vocabularyItem  VocabularyItem  @relation(fields: [vocabularyItemId], references: [id], onDelete: Cascade)
  rating          Int
  easeFactor      Float
  interval        Int
  reviewedAt      DateTime        @default(now())

  @@index([vocabularyItemId])
}

model ExamAttempt {
  id          Int      @id @default(autoincrement())
  category    String   // reading, listening, writing, grammar
  question    String
  userAnswer  String?
  correct     Boolean?
  score       Float?
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}
